{
  "name": "timemaxx",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite frontend",
    "build": "tsc -b frontend/tsconfig.json && vite build frontend",
    "preview": "vite preview frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:frontend": "vitest run --project frontend --coverage",
    "test:coverage:backend": "vitest run --project backend --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lint": "eslint frontend/src backend/convex mastra/src e2e",
    "lint:fix": "eslint frontend/src backend/convex mastra/src e2e --fix",
    "format": "prettier --write frontend/src backend/convex mastra/src e2e",
    "format:check": "prettier --check frontend/src backend/convex mastra/src e2e",
    "predeploy": "npm run build && cp frontend/dist/index.html frontend/dist/404.html",
    "deploy": "gh-pages -d frontend/dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/google": "^3.0.61",
    "@auth/core": "^0.37.4",
    "@convex-dev/auth": "^0.0.91",
    "@google/genai": "^1.44.0",
    "@mastra/client-js": "^0.17.2",
    "ai": "^6.0.154",
    "clsx": "^2.1.1",
    "convex": "^1.32.0",
    "dotenv": "^17.3.1",
    "openai": "^6.33.0",
    "pdfjs-dist": "^5.5.207",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "use-stick-to-bottom": "^1.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@libsql/client": "^0.17.2",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "convex-test": "^0.0.44",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.8.3",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
